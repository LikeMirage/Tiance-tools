{
  "type": "object",
  "description": "生成一张图片并保存到当前项目。服务固定为本机 OpenAI 兼容图片接口，模型固定为 gpt-image-2。output_compression 只适用于 jpeg 和 webp。",
  "additionalProperties": false,
  "required": [
    "prompt"
  ],
  "properties": {
    "prompt": {
      "type": "string",
      "title": "绘图提示词",
      "description": "描述要生成的画面、构图、风格、文字和限制。",
      "minLength": 1,
      "maxLength": 32000
    },
    "output_path": {
      "type": "string",
      "description": "项目内输出路径。不填时自动保存到 generated/images；文件已存在时默认拒绝覆盖。"
    },
    "overwrite": {
      "type": "boolean",
      "default": false,
      "description": "指定输出文件已存在时是否覆盖。"
    },
    "size": {
      "type": "string",
      "default": "auto",
      "description": "图片尺寸。可用 auto，或满足 gpt-image-2 约束的 WIDTHxHEIGHT，例如 1024x1024、1536x1024、1024x1536、3840x2160。"
    },
    "quality": {
      "type": "string",
      "enum": [
        "auto",
        "low",
        "medium",
        "high"
      ],
      "options": [
        {
          "value": "auto",
          "description": "由模型选择。"
        },
        {
          "value": "low",
          "description": "快速草图和预览。"
        },
        {
          "value": "medium",
          "description": "质量与速度平衡。"
        },
        {
          "value": "high",
          "description": "高质量成图。"
        }
      ],
      "default": "auto",
      "description": "渲染质量。"
    },
    "background": {
      "type": "string",
      "enum": [
        "auto",
        "opaque"
      ],
      "options": [
        {
          "value": "auto",
          "description": "由模型选择背景。"
        },
        {
          "value": "opaque",
          "description": "生成不透明背景。"
        }
      ],
      "default": "auto",
      "description": "背景模式；gpt-image-2 不支持 transparent。"
    },
    "output_format": {
      "type": "string",
      "enum": [
        "png",
        "jpeg",
        "webp"
      ],
      "options": [
        {
          "value": "png",
          "description": "无损 PNG，默认格式。"
        },
        {
          "value": "jpeg",
          "description": "体积较小、生成较快。"
        },
        {
          "value": "webp",
          "description": "兼顾质量和体积。"
        }
      ],
      "default": "png",
      "description": "图片输出格式。"
    },
    "output_compression": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "JPEG 或 WebP 压缩级别，范围 0-100；PNG 不使用。"
    },
    "timeout_seconds": {
      "type": "integer",
      "default": 600,
      "minimum": 30,
      "maximum": 600,
      "description": "本机服务请求超时时间。"
    }
  }
}
