{
  "description": "通过本机 OpenAI 兼容图片接口调用 gpt-image-2 生成图片。服务地址和模型固定，凭据从 Windows 凭据管理器或进程环境变量读取；图片保存到当前项目并以富媒体资源返回。",
  "display_name": "本机 GPT 图片生成",
  "execution": {
    "parallel": false
  },
  "files": {
    "examples": ".tool/examples.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "keywords": [
    "图片生成",
    "文生图",
    "gpt-image-2",
    "OpenAI Image API",
    "本机服务"
  ],
  "loading": {
    "dynamic": true
  },
  "name": "local_gpt_image_generate",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 620,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
