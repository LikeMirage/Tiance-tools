{
  "type": "object",
  "description": "成功时保存一张图片并返回富媒体资源和文件元信息；失败时返回稳定错误码。",
  "additionalProperties": false,
  "required": [
    "ok"
  ],
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "summary": {
      "type": "string"
    },
    "content": {
      "type": "array",
      "description": "成功时返回图片 resource_link。",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "type",
          "uri",
          "name",
          "mimeType",
          "size"
        ],
        "properties": {
          "type": {
            "const": "resource_link"
          },
          "uri": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "structuredContent": {
      "type": "object",
      "description": "生成图片的结构化文件元信息。"
    },
    "data": {
      "type": "object",
      "description": "生成图片的结构化文件元信息。"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "type": "string"
    },
    "error_info": {
      "type": "object"
    }
  }
}
